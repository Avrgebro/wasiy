APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5174,localhost:5175,127.0.0.1,127.0.0.1:5174,127.0.0.1:5175
# Add the marketing site origins (https://wasiy.co, https://stage.wasiy.co) in deployed environments so its forms can post leads.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:4321

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
WASIY_STAFF_INVITATION_EXPIRES_DAYS=14
WASIY_RESIDENT_INVITATION_EXPIRES_DAYS=14
# The three hosts emails link to: staff app, marketing site, resident portal.
# Invitation links are derived from these (config/wasiy.php); never APP_URL.
WASIY_SPA_URL=http://localhost:5174
WASIY_MARKETING_URL=http://localhost:4321
WASIY_PORTAL_URL=http://localhost:5175
# Sales inbox for marketing form submissions (POST /api/public/leads).
WASIY_LEADS_NOTIFY_EMAIL=hola@wasiy.co
# Manual payment instructions on the subscription page (ADR 0040).
WASIY_BILLING_BANK=BCP
WASIY_BILLING_ACCOUNT_TYPE="Cuenta corriente soles"
WASIY_BILLING_ACCOUNT_NUMBER=
WASIY_BILLING_CCI=
WASIY_BILLING_HOLDER="Wasiy SAC"
WASIY_BILLING_TAX_ID=
WASIY_BILLING_YAPE_NUMBER=
WASIY_BILLING_PLIN_NUMBER=
# Cloudflare Turnstile secret for the marketing forms; unset disables the check.
TURNSTILE_SECRET=
# Frontend hostnames allowed to submit Turnstile tokens (no localhost in production).
TURNSTILE_HOSTNAMES=wasiy.co,stage.wasiy.co
WASIY_ALERT_RETENTION_DAYS=90

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_ALLOWED_EMAILS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage for photos and payment proofs when FILESYSTEM_DISK=s3.
# Locally this is the RustFS service in compose.yaml: key sail / password,
# endpoint http://rustfs:9000, path-style on, bucket created once via
# `sail artisan tinker`. Leave FILESYSTEM_DISK=local to skip it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
