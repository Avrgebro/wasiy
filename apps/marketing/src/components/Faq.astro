---
import { faqs } from '../data/faqs';
---

<section id="faq">
  <div class="inner">
    <h2>Preguntas que nos hacen siempre</h2>
    <div class="list">
      {
        faqs.map((f) => (
          <details open={f.open}>
            <summary>{f.q}</summary>
            <div class="answer">{f.a}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--white);
    border-top: 1px solid var(--border);
    padding: 96px 48px;
  }

  .inner {
    max-width: 820px;
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 36px;
    font: 700 36px/1.15 var(--font-sora);
    letter-spacing: -0.02em;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  details {
    border-bottom: 1px solid var(--cream);
    padding: 20px 4px;
  }

  details:last-child {
    border-bottom: none;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font: 600 17px var(--font-sora);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    color: var(--amber-text);
    font: 600 19px var(--font-instrument);
    transition: transform 0.2s ease;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  .answer {
    font: 400 15px/1.65 var(--font-instrument);
    color: var(--muted);
    padding-top: 10px;
  }

  @media (max-width: 1024px) {
    section {
      padding: 72px 32px;
    }
  }

  @media (max-width: 700px) {
    section {
      padding: 56px 20px;
    }

    h2 {
      font-size: 28px;
    }
  }
</style>
