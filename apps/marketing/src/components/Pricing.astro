---
import { plans } from '../data/plans';
---

<section id="precios">
  <div class="inner">
    <div class="intro">
      <div class="kicker">Precios</div>
      <h2>Por unidad, por mes. Sin letra chica.</h2>
      <p>
        Pagas por las unidades que tiene el edificio. Sin licencias por usuario y sin módulos
        que se cobran aparte.
      </p>
    </div>

    <div class="grid">
      {
        plans.map((plan) => (
          <div class:list={['plan', { featured: plan.featured }]}>
            {plan.badge && <span class="badge">{plan.badge}</span>}
            <h3 class="plan-name">{plan.name}</h3>
            <div class="price">
              <span class="amount">{plan.amount}</span>
              {plan.per && <span class="per">{plan.per}</span>}
            </div>
            <div class="pitch">{plan.pitch}</div>
            <div class="features">
              {plan.features.map((feature) => (
                <span>✓ {feature}</span>
              ))}
            </div>
            <a class:list={['action', plan.ctaStyle]} href="#contacto">
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 96px 48px;
  }

  .inner {
    max-width: 1160px;
    margin: 0 auto;
  }

  .intro {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .kicker {
    font: 600 12.5px var(--font-instrument);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-mid);
  }

  h2 {
    margin: 12px 0 0;
    font: 700 42px/1.12 var(--font-sora);
    letter-spacing: -0.02em;
  }

  .intro p {
    margin: 14px 0 0;
    font: 400 17px/1.6 var(--font-instrument);
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .plan {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .plan.featured {
    background: var(--teal);
    border: none;
    position: relative;
    box-shadow: 0 16px 48px rgba(18, 78, 82, 0.25);
  }

  .badge {
    position: absolute;
    top: -13px;
    left: 30px;
    font: 600 11.5px var(--font-instrument);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--gold);
    color: var(--ink);
    border-radius: 99px;
    padding: 5px 13px;
  }

  .plan-name {
    margin: 0;
    font: 600 16px var(--font-sora);
  }

  .amount {
    font: 700 44px var(--font-sora);
    letter-spacing: -0.02em;
  }

  .per {
    font: 400 14px var(--font-instrument);
    color: var(--muted);
  }

  .pitch {
    font: 400 13.5px var(--font-instrument);
    color: var(--muted);
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font: 400 14px var(--font-instrument);
    color: var(--ink);
  }

  .featured .plan-name,
  .featured .amount,
  .featured .features {
    color: var(--bg);
  }

  .featured .per,
  .featured .pitch {
    color: var(--teal-pale);
  }

  .action {
    display: block;
    margin-top: auto;
    text-align: center;
    font: 600 14px var(--font-instrument);
    border-radius: 10px;
    padding: 12px 0;
    cursor: pointer;
  }

  .action.outline,
  .action.outline:hover {
    color: var(--teal);
    border: 1.5px solid var(--teal);
    background: transparent;
  }

  .featured .action.outline,
  .featured .action.outline:hover {
    color: var(--bg);
    border-color: var(--teal-mid);
  }

  .action.solid,
  .action.solid:hover {
    color: var(--ink);
    border: none;
  }

  .action.solid {
    background: var(--gold);
  }

  .action.solid:hover {
    background: var(--gold-light);
  }

  @media (max-width: 1024px) {
    section {
      padding: 72px 32px;
    }
  }

  @media (max-width: 900px) {
    h2 {
      font-size: 34px;
    }

    .grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }

    .plan:last-child {
      grid-column: 1 / -1;
    }

    .plan.featured {
      margin-top: 8px;
    }
  }

  @media (max-width: 640px) {
    section {
      padding: 56px 20px;
    }

    h2 {
      font-size: 30px;
    }

    .grid {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }

    .plan:last-child {
      grid-column: auto;
    }
  }
</style>
