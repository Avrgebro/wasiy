7439 14.0448 12.1517C13.3843 12.5765 12.7411 12.8449 12 12.8449C11.2589 12.8449 10.6157 12.5765 9.95518 12.1517C9.32112 11.7439 8.60272 11.1452 7.71636 10.4066L5.51986 8.57617C5.20165 8.31099 5.15866 7.83807 5.42383 7.51986Z" fill="var(--bg)"></path>
            </svg>
          </div>
          <div>
            <div class="channel-value">hola@wasiy.pe</div>
            <div class="channel-note">Para demos, precios y dudas</div>
          </div>
        </div>
        <div class="channel">
          <div class="channel-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M5.73268 2.043C6.95002 0.832583 8.95439 1.04804 9.9737 2.40962L11.2347 4.09402C12.0641 5.20191 11.9909 6.75032 11.0064 7.72923L10.7676 7.96665C10.7572 7.99694 10.7319 8.09215 10.76 8.2731C10.8232 8.6806 11.1635 9.545 12.592 10.9654C14.02 12.3853 14.8905 12.7253 15.3038 12.7887C15.4911 12.8174 15.5891 12.7906 15.6194 12.78L16.0274 12.3743C16.9026 11.5041 18.2475 11.3414 19.3311 11.9305L21.2416 12.9691C22.8775 13.8584 23.2909 16.0821 21.9505 17.4148L20.53 18.8273C20.0824 19.2723 19.4805 19.6434 18.7459 19.7119C16.9369 19.8806 12.7187 19.6654 8.28659 15.2584C4.14868 11.144 3.35462 7.556 3.25415 5.78817L4.00294 5.74562L3.25415 5.78817C3.20335 4.89426 3.62576 4.13796 4.16308 3.60369L5.73268 2.043ZM8.77291 3.30856C8.26628 2.63182 7.322 2.57801 6.79032 3.10668L5.22072 4.66737C4.8908 4.99542 4.73206 5.35695 4.75173 5.70307C4.83156 7.10766 5.47286 10.3453 9.34423 14.1947C13.4057 18.2331 17.1569 18.3536 18.6067 18.2184C18.9029 18.1908 19.1975 18.0369 19.4724 17.7636L20.8929 16.3511C21.4704 15.777 21.343 14.7315 20.5252 14.2869L18.6147 13.2484C18.0871 12.9616 17.469 13.0562 17.085 13.438L16.6296 13.8909L16.1008 13.359C16.6296 13.8909 16.6289 13.8916 16.6282 13.8923L16.6267 13.8937L16.6236 13.8967L16.6171 13.903L16.6025 13.9166C16.592 13.9262 16.5799 13.9367 16.5664 13.948C16.5392 13.9705 16.5058 13.9959 16.4659 14.0227C16.3858 14.0763 16.2801 14.1347 16.1472 14.1841C15.8764 14.285 15.5192 14.3392 15.0764 14.2713C14.2096 14.1384 13.0614 13.5474 11.5344 12.0291C10.0079 10.5113 9.41194 9.36834 9.2777 8.50306C9.20906 8.06061 9.26381 7.70331 9.36594 7.43225C9.41599 7.29941 9.47497 7.19378 9.5291 7.11389C9.5561 7.07405 9.58179 7.04074 9.60446 7.01368C9.6158 7.00015 9.6264 6.98817 9.63604 6.9777L9.64977 6.96312L9.65606 6.95666L9.65905 6.95363L9.66051 6.95217C9.66122 6.95146 9.66194 6.95075 10.1908 7.48258L9.66194 6.95075L9.94875 6.66556C10.3774 6.23939 10.4374 5.53194 10.0339 4.99297L8.77291 3.30856Z" fill="var(--bg)"></path>
            </svg>
          </div>
          <div>
            <div class="channel-value">+51 1 640 2210</div>
            <div class="channel-note">Lun–Vie, 9:00–18:00 (GMT−5)</div>
          </div>
        </div>
        <div class="channel">
          <div class="channel-icon">
            <LogoMark size={22} color="var(--bg)" />
          </div>
          <div>
            <div class="channel-value">Lima, Perú</div>
            <div class="channel-note">Atendemos todo el país, en español</div>
          </div>
        </div>
      </div>
    </div>

    <form class="card" novalidate>
      <div class="row">
        <label>
          <span class="field-label">Nombre</span>
          <input type="text" name="nombre" placeholder="María Torres" autocomplete="name" />
        </label>
        <label>
          <span class="field-label">Correo</span>
          <input type="email" name="correo" placeholder="tu@correo.com" autocomplete="email" />
        </label>
      </div>
      <div class="row">
        <label>
          <span class="field-label">Soy…</span>
          <span class="select-wrap">
            <select name="perfil">
              <option>Administradora de propiedades</option>
              <option>Junta de propietarios</option>
              <option>Desarrolladora / postventa</option>
              <option>Otro</option>
            </select>
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true">
              <path d="M3 4.5 L6 7.5 L9 4.5" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </label>
        <label>
          <span class="field-label">Unidades (aprox.)</span>
          <input type="number" name="unidades" placeholder="86" min="1" />
        </label>
      </div>
      <label>
        <span class="field-label">Mensaje</span>
        <textarea
          name="mensaje"
          placeholder="Cuéntanos qué se te está saliendo de las manos: las visitas, la parrilla, el cuaderno…"
        ></textarea>
      </label>
      <div class="footer-row">
        <span class="disclaimer">
          Al enviar aceptas que te contactemos sobre Wasiy. Nada de spam — lo prometemos como
          quien promete no usar el ascensor en mudanza.
        </span>
        <button type="button" class="submit">
          Enviar mensaje
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
            <path
              d="M3 8 h9 M8.5 4.5 L12 8 L8.5 11.5"
              stroke="var(--ink)"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  section {
    background: var(--bg);
    padding: 96px 48px;
  }

  .inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 64px;
    align-items: start;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .kicker {
    font: 600 12.5px var(--font-instrument);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-mid);
  }

  h2 {
    margin: 0;
    font: 700 42px/1.12 var(--font-sora);
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .info p {
    margin: 0;
    font: 400 17px/1.6 var(--font-instrument);
    color: var(--muted);
    max-width: 440px;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 8px;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-value {
    font: 600 14.5px var(--font-instrument);
  }

  .channel-note {
    font: 400 12.5px var(--font-instrument);
    color: var(--faint);
  }

  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px;
    box-shadow: 0 12px 40px rgba(28, 43, 44, 0.08);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .field-label {
    font: 600 12.5px var(--font-instrument);
    color: var(--muted);
  }

  input,
  select,
  textarea {
    font: 400 14.5px var(--font-instrument);
    color: var(--ink);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--white);
    width: 100%;
  }

  input,
  select {
    height: 46px;
    padding: 0 14px;
  }

  textarea {
    height: 110px;
    padding: 12px 14px;
    line-height: 1.5;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--faint);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--teal-mid);
    outline-offset: -1px;
  }

  .select-wrap {
    position: relative;
  }

  select {
    appearance: none;
    padding-right: 36px;
  }

  .select-wrap svg {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .disclaimer {
    font: 400 12px var(--font-instrument);
    color: var(--faint);
    max-width: 280px;
  }

  .submit {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--gold);
    color: var(--ink);
    border: none;
    border-radius: 12px;
    padding: 14px 26px;
    font: 600 15px var(--font-instrument);
    cursor: pointer;
    white-space: nowrap;
  }

  .submit:hover {
    background: var(--gold-light);
  }

  @media (max-width: 1024px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 700px) {
    section {
      padding: 56px 20px;
    }

    h2 {
      font-size: 30px;
    }

    .card {
      padding: 22px;
    }

    .row {
      grid-template-columns: 1fr;
    }

    .footer-row {
      flex-direction: column;
      align-items: stretch;
    }

    .disclaimer {
      max-width: none;
    }

    .submit {
      justify-content: center;
    }
  }
</style>
