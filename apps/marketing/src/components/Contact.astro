---
import LogoMark from './LogoMark.astro';
---

<section id="contacto">
  <div class="inner">
    <div class="info">
      <div class="kicker">Contacto</div>
      <h2>Cuéntanos de tu edificio. Nosotros ponemos el orden.</h2>
      <p>
        Respondemos el mismo día hábil — somos un edificio bien administrado, después de todo.
      </p>
      <div class="channels">
        <div class="channel">
          <div class="channel-icon">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
              <rect x="1.8" y="3.5" width="12.4" height="9" rx="2" stroke="var(--bg)" stroke-width="1.5"></rect>
              <path d="M2.5 5 L8 9 L13.5 5" stroke="var(--bg)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div>
            <div class="channel-value">hola@wasiy.pe</div>
            <div class="channel-note">Para demos, precios y dudas</div>
          </div>
        </div>
        <div class="channel">
          <div class="channel-icon">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
              <path
                d="M4.5 2.5 h2 l1 3 -1.5 1.2 a8 8 0 0 0 3.3 3.3 l1.2 -1.5 3 1 v2 a1.5 1.5 0 0 1 -1.6 1.5 A11.5 11.5 0 0 1 3 4.1 a1.5 1.5 0 0 1 1.5 -1.6 z"
                stroke="var(--bg)"
                stroke-width="1.4"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div>
            <div class="channel-value">+51 1 640 2210</div>
            <div class="channel-note">Lun–Vie, 9:00–18:00 (GMT−5)</div>
          </div>
        </div>
        <div class="channel">
          <div class="channel-icon">
            <LogoMark size={20} color="var(--bg)" />
          </div>
          <div>
            <div class="channel-value">Lima, Perú</div>
            <div class="channel-note">Atendemos todo el país, en español</div>
          </div>
        </div>
      </div>
    </div>

    <form class="card" novalidate>
      <div class="row">
        <label>
          <span class="field-label">Nombre</span>
          <input type="text" name="nombre" placeholder="María Torres" autocomplete="name" />
        </label>
        <label>
          <span class="field-label">Correo</span>
          <input type="email" name="correo" placeholder="tu@correo.com" autocomplete="email" />
        </label>
      </div>
      <div class="row">
        <label>
          <span class="field-label">Soy…</span>
          <span class="select-wrap">
            <select name="perfil">
              <option>Administradora de propiedades</option>
              <option>Junta de propietarios</option>
              <option>Desarrolladora / postventa</option>
              <option>Otro</option>
            </select>
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true">
              <path d="M3 4.5 L6 7.5 L9 4.5" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </label>
        <label>
          <span class="field-label">Unidades (aprox.)</span>
          <input type="number" name="unidades" placeholder="86" min="1" />
        </label>
      </div>
      <label>
        <span class="field-label">Mensaje</span>
        <textarea
          name="mensaje"
          placeholder="Cuéntanos qué se te está saliendo de las manos: las visitas, la parrilla, el cuaderno…"
        ></textarea>
      </label>
      <div class="footer-row">
        <span class="disclaimer">
          Al enviar aceptas que te contactemos sobre Wasiy. Nada de spam — lo prometemos como
          quien promete no usar el ascensor en mudanza.
        </span>
        <button type="button" class="submit">
          Enviar mensaje
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
            <path
              d="M3 8 h9 M8.5 4.5 L12 8 L8.5 11.5"
              stroke="var(--ink)"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  section {
    background: var(--bg);
    padding: 96px 48px;
  }

  .inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 64px;
    align-items: start;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .kicker {
    font: 600 12.5px var(--font-instrument);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-mid);
  }

  h2 {
    margin: 0;
    font: 700 42px/1.12 var(--font-sora);
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .info p {
    margin: 0;
    font: 400 17px/1.6 var(--font-instrument);
    color: var(--muted);
    max-width: 440px;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 8px;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-value {
    font: 600 14.5px var(--font-instrument);
  }

  .channel-note {
    font: 400 12.5px var(--font-instrument);
    color: var(--faint);
  }

  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px;
    box-shadow: 0 12px 40px rgba(28, 43, 44, 0.08);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .field-label {
    font: 600 12.5px var(--font-instrument);
    color: var(--muted);
  }

  input,
  select,
  textarea {
    font: 400 14.5px var(--font-instrument);
    color: var(--ink);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--white);
    width: 100%;
  }

  input,
  select {
    height: 46px;
    padding: 0 14px;
  }

  textarea {
    height: 110px;
    padding: 12px 14px;
    line-height: 1.5;
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--faint);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--teal-mid);
    outline-offset: -1px;
  }

  .select-wrap {
    position: relative;
  }

  select {
    appearance: none;
    padding-right: 36px;
  }

  .select-wrap svg {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .disclaimer {
    font: 400 12px var(--font-instrument);
    color: var(--faint);
    max-width: 280px;
  }

  .submit {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--gold);
    color: var(--ink);
    border: none;
    border-radius: 12px;
    padding: 14px 26px;
    font: 600 15px var(--font-instrument);
    cursor: pointer;
    white-space: nowrap;
  }

  .submit:hover {
    background: var(--gold-light);
  }

  @media (max-width: 1024px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 700px) {
    section {
      padding: 56px 20px;
    }

    h2 {
      font-size: 30px;
    }

    .card {
      padding: 22px;
    }

    .row {
      grid-template-columns: 1fr;
    }

    .footer-row {
      flex-direction: column;
      align-items: stretch;
    }

    .disclaimer {
      max-width: none;
    }

    .submit {
      justify-content: center;
    }
  }
</style>
