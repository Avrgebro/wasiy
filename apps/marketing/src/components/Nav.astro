---
import LogoMark from './LogoMark.astro';
---

<nav>
  <div class="bar">
    <div class="brand">
      <LogoMark />
      <span class="wordmark">wasiy</span>
    </div>
    <div class="actions">
      <div class="links">
        <a href="#dia">Un día con Wasiy</a>
        <a href="#modulos">Producto</a>
        <a href="#precios">Precios</a>
        <a href="#faq">FAQ</a>
        <a href="#contacto">Contacto</a>
      </div>
      <button type="button" class="cta">
        <span class="cta-full">Solicitar demo</span>
        <span class="cta-short">Demo</span>
      </button>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Abrir menú">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M3 5.5 h12 M3 9 h12 M3 12.5 h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="overlay" id="nav-menu" inert>
    <svg
      class="overlay-arches"
      viewBox="0 0 48 48"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M8 12 v16 a8 8 0 0 0 16 0 v-16 M24 12 v16 a8 8 0 0 0 16 0 v-16 M40 28 v6 a2 2 0 0 1 -2 2 h-6"
        stroke="var(--teal-soft)"
        stroke-width="6.5"
        stroke-linecap="round"></path>
      <circle cx="32" cy="19" r="3.5" fill="var(--gold)" class="overlay-pulse"></circle>
    </svg>
    <div class="overlay-bar">
      <div class="brand">
        <LogoMark size={26} color="var(--bg)" />
        <span class="wordmark inverted">wasiy</span>
      </div>
      <button type="button" class="menu-close" aria-label="Cerrar menú">
        <svg viewBox="0 0 18 18" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M4.5 4.5 L13.5 13.5 M13.5 4.5 L4.5 13.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="overlay-links">
      <a href="#dia">Un día con Wasiy<span class="arrow" aria-hidden="true"></span></a>
      <a href="#modulos">Producto<span class="arrow" aria-hidden="true"></span></a>
      <a href="#precios">Precios<span class="arrow" aria-hidden="true"></span></a>
      <a href="#faq">FAQ<span class="arrow" aria-hidden="true"></span></a>
      <a href="#contacto">Contacto<span class="arrow" aria-hidden="true"></span></a>
    </div>
    <div class="overlay-footer">
      <button type="button" class="overlay-cta">Solicitar demo</button>
      <div class="overlay-contact">hola@wasiy.pe · +51 1 640 2210</div>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('nav');
  const toggle = nav?.querySelector('.menu-toggle');
  const closeBtn = nav?.querySelector('.menu-close');
  const overlay = nav?.querySelector('.overlay');

  const setOpen = (open: boolean) => {
    nav?.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    if (open) {
      overlay?.removeAttribute('inert');
    } else {
      overlay?.setAttribute('inert', '');
    }
  };

  toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
  closeBtn?.addEventListener('click', () => setOpen(false));

  overlay?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  const wide = window.matchMedia('(min-width: 861px)');
  wide.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 48px;
    background: rgba(247, 245, 240, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .wordmark {
    font: 600 21px var(--font-sora);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .wordmark.inverted {
    color: var(--bg);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    font: 600 14px var(--font-instrument);
  }

  .cta {
    font: 600 14px var(--font-instrument);
    background: var(--gold);
    color: var(--ink);
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    cursor: pointer;
  }

  .cta:hover {
    background: var(--gold-light);
  }

  .cta-short {
    display: none;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    border: 1px solid var(--card-border);
    background: var(--white);
    color: var(--ink);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .overlay {
    display: none;
  }

  @media (max-width: 860px) {
    .bar {
      padding: 14px 18px;
    }

    .actions {
      gap: 10px;
    }

    .links {
      display: none;
    }

    .cta {
      font-size: 13px;
      border-radius: 9px;
      padding: 9px 14px;
    }

    .cta-full {
      display: none;
    }

    .cta-short {
      display: inline;
    }

    .menu-toggle {
      display: flex;
    }

    .overlay {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0;
      background: var(--teal);
      overflow: hidden;
      clip-path: circle(0% at top right);
      visibility: hidden;
      transition: clip-path 0.5s ease, visibility 0s linear 0.5s;
    }

    nav.open .overlay {
      clip-path: circle(150% at top right);
      visibility: visible;
      transition: clip-path 0.5s ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .overlay {
        transition: none;
      }
    }

    .overlay-arches {
      position: absolute;
      bottom: -75px;
      right: -45px;
      width: 600px;
      height: 600px;
    }

    .overlay-pulse {
      animation: wa-pulse 3s ease-in-out infinite;
    }

    .overlay-bar {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
    }

    .menu-close {
      width: 44px;
      height: 44px;
      border-radius: 11px;
      border: 1px solid var(--teal-mid);
      background: none;
      color: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .overlay-links {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 28px 22px;
      overflow-y: auto;
    }

    .overlay-links a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font: 600 27px var(--font-sora);
      letter-spacing: -0.02em;
      color: var(--bg);
      padding: 13px 4px;
      border-bottom: 1px solid var(--teal-soft);
    }

    .overlay-links a:last-child {
      border-bottom: none;
    }

    .arrow {
      width: 17px;
      height: 17px;
      flex-shrink: 0;
      background: no-repeat center / contain
        url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' xmlns='http://www.w3.org/2000/svg' fill='none'%3E%3Cpath d='M3 8 h9 M8.5 4.5 L12 8 L8.5 11.5' stroke='%23E0A438' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    }

    .overlay-footer {
      position: relative;
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .overlay-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--gold);
      color: var(--ink);
      border: none;
      border-radius: 12px;
      padding: 15px 0;
      font: 600 15px var(--font-instrument);
      cursor: pointer;
    }

    .overlay-cta:hover {
      background: var(--gold-light);
    }

    .overlay-contact {
      text-align: center;
      font: 400 12.5px var(--font-instrument);
      color: var(--teal-faded);
    }
  }
</style>
