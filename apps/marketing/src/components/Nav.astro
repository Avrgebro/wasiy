---
import LogoMark from './LogoMark.astro';
---

<nav>
  <div class="brand">
    <LogoMark />
    <span class="wordmark">wasiy</span>
  </div>
  <div class="links">
    <a href="#dia">Un día con Wasiy</a>
    <a href="#modulos">Producto</a>
    <a href="#precios">Precios</a>
    <a href="#faq">FAQ</a>
    <button type="button" class="cta">Solicitar demo</button>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 48px;
    background: rgba(247, 245, 240, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .wordmark {
    font: 600 21px var(--font-sora);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    font: 600 14px var(--font-instrument);
  }

  .cta {
    font: 600 14px var(--font-instrument);
    background: var(--gold);
    color: var(--ink);
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    cursor: pointer;
  }

  .cta:hover {
    background: var(--gold-light);
  }

  @media (max-width: 860px) {
    nav {
      padding: 14px 20px;
    }

    .links {
      gap: 18px;
    }

    .links a {
      display: none;
    }
  }
</style>
