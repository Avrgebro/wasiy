---
const testimonials = [
  {
    quote:
      '«Recepción dejó de ser un teléfono sonando. Las visitas llegan anunciadas y el cuaderno pasó a la historia.»',
    initials: 'MP',
    color: '#3E7C80',
    name: 'Marcela P.',
    role: 'Administradora · 4 edificios, Lima',
  },
  {
    quote:
      '«La parrilla era una guerra civil cada verano. Ahora se reserva, se paga la cuota y nadie discute en el chat del edificio.»',
    initials: 'JR',
    color: '#5B4970',
    name: 'Javier R.',
    role: 'Presidente de junta · 86 unidades',
  },
  {
    quote:
      '«Entregamos el edificio con Wasiy ya configurado. La junta nueva heredó un registro limpio en vez de una caja de folders.»',
    initials: 'AC',
    color: '#B4502D',
    name: 'Andrea C.',
    role: 'Gerente de postventa · desarrolladora',
  },
];
---

<section>
  <div class="inner">
    <h2>Lo que dicen los edificios que ya durmieron tranquilos</h2>
    <div class="grid">
      {
        testimonials.map((t) => (
          <div class="card">
            <div class="quote">{t.quote}</div>
            <div class="person">
              <div class="avatar" style={`background:${t.color}`}>
                {t.initials}
              </div>
              <div>
                <div class="name">{t.name}</div>
                <div class="role">{t.role}</div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="disclaimer">Testimonios ilustrativos para la maqueta.</div>
  </div>
</section>

<style>
  section {
    padding: 96px 48px;
  }

  .inner {
    max-width: 1160px;
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 40px;
    font: 700 36px/1.15 var(--font-sora);
    letter-spacing: -0.02em;
    max-width: 560px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quote {
    font: 400 16px/1.6 var(--font-instrument);
    color: var(--ink);
  }

  .person {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: auto;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 99px;
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 600 13px var(--font-instrument);
    flex-shrink: 0;
  }

  .name {
    font: 600 13.5px var(--font-instrument);
  }

  .role {
    font: 400 12px var(--font-instrument);
    color: var(--faint);
  }

  .disclaimer {
    font: 400 12px var(--font-instrument);
    color: var(--faint);
    margin-top: 14px;
  }

  @media (max-width: 1024px) {
    section {
      padding: 72px 32px;
    }
  }

  @media (max-width: 900px) {
    h2 {
      font-size: 32px;
    }

    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .card:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    section {
      padding: 56px 20px;
    }

    h2 {
      font-size: 28px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .card:last-child {
      grid-column: auto;
    }
  }
</style>
