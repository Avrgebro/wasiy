<style>
  section {
    padding: 96px 48px;
  }

  .inner {
    max-width: 1160px;
    margin: 0 auto;
  }

  .intro {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .kicker {
    font: 600 12.5px var(--font-instrument);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-mid);
  }

  h2 {
    margin: 12px 0 0;
    font: 700 42px/1.12 var(--font-sora);
    letter-spacing: -0.02em;
  }

  .intro p {
    margin: 14px 0 0;
    font: 400 17px/1.6 var(--font-instrument);
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .title {
    font: 600 20px var(--font-sora);
  }

  .body {
    font: 400 14.5px/1.6 var(--font-instrument);
    color: var(--muted);
  }

  .tags {
    font: 600 13px var(--font-instrument);
    color: var(--teal-mid);
  }

  @media (max-width: 900px) {
    section {
      padding: 56px 20px;
    }

    h2 {
      font-size: 30px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
