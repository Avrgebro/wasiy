---
import { Font } from 'astro:assets';
import { SITE, absolute, isCanonicalProduction } from '../site';
import SchemaOrg from '../components/SchemaOrg.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of the index (404s, thank-you pages, etc.). */
  noindex?: boolean;
  /** Emit FAQPage structured data — only for pages rendering the FAQ list. */
  includeFaq?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  includeFaq = false,
} = Astro.props;

// Self-referencing canonical, built from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Only the canonical production deployment may be indexed — see site.ts.
const blockIndexing = noindex || !isCanonicalProduction();

const ogImage = absolute(SITE.ogImage);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      blockIndexing && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wasiy — software de operación residencial" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#124e52" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-instrument" preload />
    <SchemaOrg includeFaq={includeFaq} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --ink: #1c2b2c;
    --teal: #124e52;
    --teal-dark: #0a3538;
    --teal-deep: #0f4245;
    --teal-soft: #1a5f63;
    --teal-mid: #3e7c80;
    --teal-pale: #a9c4c0;
    --teal-faded: #8fb3af;
    --gold: #e0a438;
    --gold-light: #e8b45c;
    --muted: #5a6b6b;
    --faint: #9aa6a4;
    --border: #e4e0d6;
    --card-border: #dde4e1;
    --cream: #efebe2;
    --hero-arch: #e8e4da;
    --green: #2e7d5b;
    --green-bg: #e6f1eb;
    --amber-text: #b97f24;
    --amber-bg: #f7eedd;
    --white: #ffffff;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-instrument), sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--teal);
    text-decoration: none;
  }

  a:hover {
    color: var(--teal-dark);
  }

  @keyframes wa-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  @keyframes wa-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes wa-bar {
    0% {
      width: 12%;
    }
    60% {
      width: 74%;
    }
    100% {
      width: 74%;
    }
  }

  @keyframes wa-tick {
    0%,
    45% {
      transform: scale(0);
      opacity: 0;
    }
    55% {
      transform: scale(1.15);
      opacity: 1;
    }
    65%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>
