# Both are required; the build fails with a clear error if either is missing.
# Bare host or full origin both work. Set them per environment in the Vercel
# dashboard (production -> app.wasiy.co, stage project -> app.stage.wasiy.co).
# For local builds copy this file to .env.

# Staff app: header "Acceder" and the plan cards' "Empezar prueba gratis".
APP_URL=app.stage.wasiy.co

# Laravel API the contact and demo forms post to (POST /api/public/leads).
API_URL=api.stage.wasiy.co
